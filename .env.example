# Port d'écoute du serveur HTTP.
PORT=8080

# URL de connexion PostgreSQL. Obligatoire, pas de défaut.
DATABASE_URL=postgres://numflex:numflex@localhost:5432/numflex?sslmode=disable

# Secret de signature des jetons JWT (HS512).
JWT_SECRET=numflex-sandbox-dev-secret

# Durée de validité des jetons JWT, en heures.
JWT_TTL_HOURS=24

# Fidélité du moteur : "real" ou "contract".
FIDELITY=real

# Délai d'expiration d'une étape, en secondes. 0 = pas d'expiration.
ETAPE_TIMEOUT_SECONDS=349

# Cadence du moteur, en secondes.
ENGINE_TICK_SECONDS=10

# Durée minimale de convergence, en secondes.
CONVERGENCE_MIN_SECONDS=60

# Durée maximale de convergence, en secondes.
CONVERGENCE_MAX_SECONDS=360

# Latence simulée de complétion, en millisecondes.
COMPLETION_LATENCY_MS=30500

# Tolérance de dérive d'horloge, en secondes.
CLOCK_SKEW_SECONDS=540

# Code OTP statique utilisé en fidélité "contract".
OTP_STATIC_CODE=123456

# Durée de validité de l'OTP, en secondes.
OTP_TTL_SECONDS=300

# Nombre maximal de tentatives de saisie de l'OTP.
OTP_MAX_ATTEMPTS=3

# Délai avant validation automatique du reverse, en secondes. 0 = validation par CLI uniquement.
REVERSE_AUTO_VALIDATION_SECONDS=0
