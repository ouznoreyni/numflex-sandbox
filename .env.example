# Copy to `.env` and adjust. The file is read at startup by both the server
# and the `artp` CLI: from the current directory, or from the path given by
# ENV_FILE / --env-file. It never overrides a variable already present in the
# environment — `docker run -e`, compose's `environment:` and `KEY=value`
# arguments all win over it.
#
# A comment takes a line of its own: outside quotes, everything after the `=`
# belongs to the value, `#` included.

# Listening port of the HTTP server.
PORT=8080

# Serves /swagger.html, /openapi.yaml and /openapi.json at the root — never
# under /api/gateway/v1, which keeps exactly its 33 routes. false gives back
# the platform's exact surface. The slim `runtime` image ships no such files,
# so it serves none either way.
DOCS_ENABLED=true

# PostgreSQL connection URL. Required, no default.
DATABASE_URL=postgres://numflex:numflex@localhost:5432/numflex?sslmode=disable

# Signing secret for the JWT tokens (HS512).
JWT_SECRET=numflex-sandbox-dev-secret

# Lifetime of the JWT tokens, in hours.
JWT_TTL_HOURS=24

# Engine fidelity: "real" or "contract".
FIDELITY=real

# Expiry delay of a step, in seconds. 0 = no expiry.
STEP_TIMEOUT_SECONDS=349

# Engine tick rate, in seconds.
ENGINE_TICK_SECONDS=10

# Convergence window, in seconds. 0 (the default) = the transition applies
# within the request and the response carries the NEXT step, like the
# responses captured on 2026-08-27. A value > 0 defers the transition: the
# response then carries the previous step, the behaviour measured at SIT v0.3
# (R-10).
CONVERGENCE_MIN_SECONDS=0
CONVERGENCE_MAX_SECONDS=0

# Simulated completion latency, in milliseconds.
COMPLETION_LATENCY_MS=30500

# Clock skew tolerance, in seconds.
CLOCK_SKEW_SECONDS=540

# Static OTP code used in "contract" fidelity.
OTP_STATIC_CODE=123456

# Lifetime of the OTP, in seconds.
OTP_TTL_SECONDS=300

# Maximum number of OTP entry attempts.
OTP_MAX_ATTEMPTS=3

# Delay before automatic validation of a reverse, in seconds. 0 = validation
# through the CLI only.
REVERSE_AUTO_VALIDATION_SECONDS=0

# Fills every portable range whole — 771000000 to 771999999, and so on to
# 778 — so any well-formed number of a range exists. It costs what it counts:
# 4 min 20 s of cold start and 1.9 GB for the numero table, measured, paid
# again at every start of a container without a persistent volume. Left
# false, a range carries its first hundred thousand numbers and the container
# is up in about twenty seconds.
FULL_NUMBERS=false

# Never-ported numbers seeded for ORANGE and for YAS, each, spread over their
# eight ranges — the pool a successful porting consumes, one number per
# cycle. Between 8 and 8000000. Absent, it follows FULL_NUMBERS: 800000
# normally, 8000000 when the ranges are asked full. Set here, it wins over
# FULL_NUMBERS, so the two can never contradict each other.
# POOL_NUMBERS_PER_OPERATOR=800000

# CORS is not configurable: every origin is allowed, always, so a page
# served from anywhere calls the API without a variable to find. The header
# only goes out when the request carries an Origin, so a server-to-server
# call still gets exactly the three headers the platform sends.
#
# The two /api/sandbox/v1 routes — the range count and the test-data purge —
# are mounted unconditionally too. Neither has a flag any more.
