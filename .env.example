# Copier en `.env` et ajuster. Le fichier est lu au démarrage du serveur comme
# du CLI `artp` : depuis le répertoire courant, ou depuis le chemin posé par
# ENV_FILE / --env-file. Il ne surcharge jamais une variable déjà présente dans
# l'environnement — `docker run -e`, `environment:` de compose et les arguments
# `CLEF=valeur` l'emportent sur lui.
#
# Un commentaire occupe sa propre ligne : hors guillemets, tout ce qui suit le
# `=` appartient à la valeur, `#` compris.

# Port d'écoute du serveur HTTP.
PORT=8080

# URL de connexion PostgreSQL. Obligatoire, pas de défaut.
DATABASE_URL=postgres://numflex:numflex@localhost:5432/numflex?sslmode=disable

# Secret de signature des jetons JWT (HS512).
JWT_SECRET=numflex-sandbox-dev-secret

# Durée de validité des jetons JWT, en heures.
JWT_TTL_HOURS=24

# Fidélité du moteur : "real" ou "contract".
FIDELITY=real

# Délai d'expiration d'une étape, en secondes. 0 = pas d'expiration.
ETAPE_TIMEOUT_SECONDS=349

# Cadence du moteur, en secondes.
ENGINE_TICK_SECONDS=10

# Fenêtre de convergence, en secondes. 0 (le défaut) = la transition s'applique
# dans la requête et la réponse porte l'étape SUIVANTE, comme les réponses
# capturées le 2026-08-27. Une valeur > 0 diffère la transition : la réponse
# porte alors l'étape précédente, comportement mesuré au SIT v0.3 (R-10).
CONVERGENCE_MIN_SECONDS=0
CONVERGENCE_MAX_SECONDS=0

# Latence simulée de complétion, en millisecondes.
COMPLETION_LATENCY_MS=30500

# Tolérance de dérive d'horloge, en secondes.
CLOCK_SKEW_SECONDS=540

# Code OTP statique utilisé en fidélité "contract".
OTP_STATIC_CODE=123456

# Durée de validité de l'OTP, en secondes.
OTP_TTL_SECONDS=300

# Nombre maximal de tentatives de saisie de l'OTP.
OTP_MAX_ATTEMPTS=3

# Délai avant validation automatique du reverse, en secondes. 0 = validation par CLI uniquement.
REVERSE_AUTO_VALIDATION_SECONDS=0

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Variable absente — le défaut — `*`, toute origine, pour que la page
# Swagger fonctionne sans configuration. La renseigner restreint la liste ; la
# poser vide éteint le CORS et rend au sandbox le silence de la plateforme
# réelle. C'est la seule variable où vide et absent diffèrent.
# CORS_ALLOWED_ORIGINS=http://localhost:8081

# Ouvre DELETE /api/sandbox/v1/demandes, la purge des données de test. Hors
# contrat ARTP : à false — le défaut — la route n'est pas enregistrée et répond
# 404. /api/gateway/v1 garde ses 33 routes dans les deux cas.
SANDBOX_ADMIN=false
